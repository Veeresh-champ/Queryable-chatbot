// Cloudflare Workers config for the Next.js frontend (built with OpenNext).
// The FastAPI backend runs elsewhere (Render); BACKEND_URL is baked into the
// /api/* rewrite at build time, so set it before `npm run cf:deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queryable-chatbot",
  "main": "custom-worker.js",
  // Needed to stay under the 3 MiB (gzip) Worker size limit on the free plan.
  "minify": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "queryable-chatbot"
    }
  ],
  // Every 10 minutes: ping the Render backend so it never goes to sleep
  // (see custom-worker.js). Free plan allows up to 5 cron triggers.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "SESSION_COOKIE_NAME": "qc_session",
    // Backend pinged by the keep-warm cron (not a secret).
    "BACKEND_URL": "https://queryable-chatbot-api.onrender.com"
  },
  "observability": {
    "enabled": true
  }
}
